# syntax=docker/dockerfile:1
# 開発用イメージ。本番用の backend/Dockerfile とは別で、ビルドせず tsx でソースを直接実行する。
# ビルドコンテキストはリポジトリルート: compose.yaml から使われる。
#
# 依存関係は、このイメージのビルド時に入れる。package.json やロックファイルが変わると、
# compose の watch が `rebuild` を実行してこのイメージを作り直す。ソースの変更は作り直さず、コンテナにコピーする。

FROM node:24-slim
WORKDIR /repo
RUN corepack enable
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml tsconfig.base.json ./
COPY backend/package.json backend/
# pnpm のストアをキャッシュマウントに置く。イメージの作り直し (rebuild) で、ダウンロード済みのパッケージを再利用する。
# キャッシュはイメージに含まれず、Docker のビルドキャッシュとして残る（BuildKit が必要。Docker Engine 23 以降は既定）。
RUN --mount=type=cache,id=pnpm-store,target=/pnpm-store \
    pnpm install --frozen-lockfile --filter @app/backend... --store-dir /pnpm-store
COPY backend backend
WORKDIR /repo/backend
EXPOSE 8080
# `tsx watch` は、ファイルが変わると API を再起動する。
CMD ["pnpm", "exec", "tsx", "watch", "src/main.ts"]
