# syntax=docker/dockerfile:1
# スキーマのマイグレーションを適用して終了するイメージ。ビルドコンテキストはリポジトリルート: docker build -f backend/Dockerfile.migrate .
# Community Edition(Apache-2.0)を使う。標準の arigaio/atlas は Atlas の独自ライセンスで配布されている。
# タグを変えるときは compose.yaml の migrate サービスも揃える。

FROM arigaio/atlas:1.3.1-community-distroless@sha256:76cc66fb31f99d5d316676b8a9866ef4b6d6bf5aacc0639485d04848670839e4
COPY backend/atlas.hcl /atlas.hcl
COPY backend/migrations /migrations
USER 65532:65532
CMD ["migrate", "apply", "--config", "file:///atlas.hcl", "--env", "cluster"]
